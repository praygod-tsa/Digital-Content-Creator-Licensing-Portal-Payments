# Django core
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False

# Host settings (Render Web Service URL)
ALLOWED_HOSTS=creator-portal-web.onrender.com
CSRF_TRUSTED_ORIGINS=https://creator-portal-web.onrender.com

# Primary database URL (recommended on Render)
# postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Optional Supabase settings
# NOTE: SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are for Supabase APIs,
# not direct PostgreSQL connections.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Use this only if you want Django to connect directly to Supabase Postgres.
# Example: postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DATABASE_URL=

# Ensure compatible Python runtime on Render
PYTHON_VERSION=3.11.9
